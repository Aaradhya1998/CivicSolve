GEMINI_API_KEY=your_gemini_api_key

# Supabase Auth (required for production auth)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# Supabase DB sync from backend (server-only secret; never expose in frontend)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Auth hardening
# Keep JWT_SECRET long/random in production
JWT_SECRET=replace_with_a_long_random_secret
# Optional server-side pepper for password hashing (do not expose to clients)
PASSWORD_PEPPER=
# bcrypt cost factor (10-14 recommended)
BCRYPT_ROUNDS=12

# Email OTP delivery via SMTP
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="CivicSolve <no-reply@yourdomain.com>"
OTP_EMAIL_SUBJECT="Your CivicSolve verification code"

# Phone OTP delivery via Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_PHONE=+12345678900

# Keep this true only for local testing when delivery providers are not configured
OTP_DEV_FALLBACK=true
